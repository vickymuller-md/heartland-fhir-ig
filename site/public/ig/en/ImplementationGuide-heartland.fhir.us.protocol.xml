      </reference>
      <name value="HEARTLAND Complete Risk Input Response"/>
      <description value="Complete, flat, explicitly answered Boolean input contract for the candidate risk questionnaire. Link IDs identify the ten weighted criteria; response order must also match the Questionnaire. This profile does not resolve unknown clinical inputs, validate the risk heuristic, or prove a referenced RiskAssessment total."/>
      <exampleBoolean value="false"/>
    </resource>
