        <reference value="StructureDefinition/heartland-patient"/>
      </reference>
      <name value="HEARTLAND Patient"/>
      <description value="Patient profile carrying HEARTLAND-specific extensions used by the risk score: distance to cardiology and social support status. Constrains the base FHIR R4 Patient resource for use within HEARTLAND Protocol v3.2 workflows."/>
      <exampleBoolean value="false"/>
    </resource>
