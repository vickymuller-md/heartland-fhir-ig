        <reference value="CodeSystem/heartland-implementation-tier"/>
      </reference>
      <name value="HEARTLAND Implementation Tier"/>
      <description value="Declared facility implementation capacity tiers, retaining historical code identities. Capacity informs delivery format, sequence and support; it does not determine clinical eligibility, permit delayed risk-led care or exclude educational domains. All eight domains are offered at every tier. These labels are not a scored readiness instrument or proof of actual coverage."/>
      <exampleBoolean value="false"/>
    </resource>
