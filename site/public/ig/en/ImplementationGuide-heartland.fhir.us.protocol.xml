      </reference>
      <name value="Example: Risk Input Questionnaire Response (score 11)"/>
      <description value="Responses to the HeartlandRiskInputQuestionnaire for PatientExampleRural. Six items answered true (age &gt;=75, prior HF hosp 6mo, SBP &lt;100, CKM Stage 3-4, distance &gt;50 mi, limited social support) totaling 11 points -&gt; High Risk tier. Referenced by RiskAssessmentExampleHigh.basis[0]."/>
      <exampleCanonical value="https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-input-response"/>
    </resource>
