      </reference>
      <name value="Example: Synthetic Body Weight Observation"/>
      <description value="Single synthetic body-mass reading. Historical resource ID retained for compatibility; this example does not establish a weight change, alert, delivery, or clinical response. A rate-of-change threshold is not a numeric reference range for body mass."/>
      <exampleCanonical value="https://fhir.heartlandprotocol.org/StructureDefinition/heartland-remote-monitoring-observation"/>
    </resource>
