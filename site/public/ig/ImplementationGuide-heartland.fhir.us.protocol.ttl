       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Evidence Level Value Set" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "All evidence level codes (established | emerging | pragmatic)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 10 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-facility-tier> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-facility-tier" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Facility Implementation Tier" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Records the declared implementation capacity tier (1 Minimal, 2 Standard, 3 Advanced) for a facility, organization or care plan. Tier guides delivery format, sequence and support; it does not authorize reduced clinical requirements, delayed risk-led follow-up or exclusion of an educational domain. A recorded tier is not validated readiness, staffing coverage or an automatic assignment." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 11 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Questionnaire" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/Questionnaire/heartland-facility-tier-questionnaire> ;
         fhir:Reference.reference [ fhir:value "Questionnaire/heartland-facility-tier-questionnaire" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Facility Tier Questionnaire" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Five capacity-capture items (four choices and one Boolean) for staffing, pharmacy, community health workers, monitoring and financial navigation. This descriptive instrument does not assign a tier, establish clinical eligibility or verify readiness. Capacity gaps, responsible professionals, coverage and an agreed implementation tier require separate documentation. Candidate 0.3.0 revises four answer strings; historical responses retain their original version and values." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 12 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/CodeSystem/heartland-implementation-tier> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/heartland-implementation-tier" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Implementation Tier" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Declared facility implementation capacity tiers, retaining historical code identities. Capacity informs delivery format, sequence and support; it does not determine clinical eligibility, permit delayed risk-led care or exclude educational domains. All eight domains are offered at every tier. These labels are not a scored readiness instrument or proof of actual coverage." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
