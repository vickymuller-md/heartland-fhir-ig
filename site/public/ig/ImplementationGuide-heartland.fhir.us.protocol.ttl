       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Implementation Tier Value Set" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "All facility implementation tier codes (tier-1-minimal | tier-2-standard | tier-3-advanced)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 14 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Questionnaire" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/Questionnaire/heartland-patient-track-questionnaire> ;
         fhir:Reference.reference [ fhir:value "Questionnaire/heartland-patient-track-questionnaire" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Monitoring Access Questionnaire" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Three Boolean items capture smartphone/connectivity, app comfort and telephone access. They do not capture patient preference or automatically assign a monitoring route. Choice, supported alternatives and an unresolved access gap require separate documentation. Existing questionnaire identity and item link IDs are preserved." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 15 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/ValueSet/heartland-monitoring-observation-code-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/heartland-monitoring-observation-code-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Monitoring Observation Code Value Set" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "LOINC codes for the four observations captured by the HEARTLAND remote monitoring kit per Module 5: body weight (digital scale), systolic and diastolic blood pressure (BP monitor), and oxygen saturation (pulse oximeter, when indicated)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 16 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/CodeSystem/heartland-monitoring-track> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/heartland-monitoring-track" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Monitoring Track" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Documented monitoring routes with stable Track A and Track B codes. A route does not establish equivalent outcomes, successful contact, device availability or completed monitoring. Clinical requirements are not reduced by the route; access, preference and the supported local plan require separate documentation." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 17 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-monitoring-track-ext> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-monitoring-track-ext" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Monitoring Track Assignment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Records a documented CarePlan monitoring route: Track A (digital) or Track B (analog, telephone/paper). Access, patient preference and the supported local plan inform the choice; facility tier alone does not select a route. The code does not prove contact, completed monitoring or equivalent outcomes, and does not change clinical requirements. No third hybrid code is defined." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 18 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/ValueSet/heartland-monitoring-track-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/heartland-monitoring-track-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Monitoring Track Value Set" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "All remote monitoring track codes (digital-track-a | analog-track-b)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 19 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-patient> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-patient" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Patient" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Patient profile carrying HEARTLAND-specific extensions used by the risk score: distance to cardiology and social support status. Constrains the base FHIR R4 Patient resource for use within HEARTLAND Protocol v3.2 workflows." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 20 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-true-points> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-risk-true-points" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Points for a True Answer" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Positive weight for an explicitly true Boolean answer to a risk questionnaire item. False contributes zero. Missing or unknown is not false and must not be scored by omission. This extension records a weight, not a validated outcome probability or an executable calculation." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 21 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-questionnaire-response> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-questionnaire-response" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Questionnaire Response" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Captures responses to any HEARTLAND-defined Questionnaire (risk inputs, facility tier self-assessment, or patient track assignment). Used as the basis reference for HeartlandRiskAssessment when the questionnaire is HeartlandRiskInputQuestionnaire." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 22 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-remote-monitoring-observation> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-remote-monitoring-observation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Remote Monitoring Observation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Draft representation of body weight, blood pressure, or oxygen saturation. This profile does not encode or validate a clinical alert algorithm. A body-mass observation must not use a rate-of-change threshold as its numeric reference range. Time-window comparisons need dated source observations, matching units, and a separately governed clinical policy. Synthetic examples do not establish alert delivery, clinical assessment, or clinical outcomes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 23 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-assessment> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-risk-assessment" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Risk Assessment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Heart failure risk stratification per the HEARTLAND Protocol v3.2 risk score. The score sums up to 18 points across ten weighted criteria and maps to three qualitative tiers: low (0-4), moderate (5-8), high (>=9). It is a non-validated implementation heuristic that assigns monitoring intensity; it does not predict an outcome and has not been validated against outcome data. For the complete Boolean capture contract use HeartlandRiskInputResponse. Legacy Observation and generic QuestionnaireResponse basis references remain allowed for compatibility; this profile alone does not validate their content or recompute the total. The tier travels in prediction.qualitativeRisk and the point total in the heartland-risk-score-total extension; probability[x] is prohibited, because a point count is not a likelihood of an outcome." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 24 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Questionnaire" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/Questionnaire/heartland-risk-input-questionnaire> ;
         fhir:Reference.reference [ fhir:value "Questionnaire/heartland-risk-input-questionnaire" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Risk Input Questionnaire" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Captures ten weighted criteria using Boolean answers for the historical HEARTLAND risk-score definition. Each item carries HeartlandRiskTruePoints for the contribution of an explicit true answer; false contributes zero, and an absent answer is not false. Total score (0-18) maps to qualitative tiers: low (0-4), moderate (5-8), high (>=9). Item text is verbatim from manuscript/tables.R Table 1 (HEARTLAND v3.2)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 25 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/CodeSystem/heartland-risk-score> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/heartland-risk-score" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Risk Score Codes" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Codes identifying the HEARTLAND risk score and its tier when either is carried on an Observation rather than on a RiskAssessment — for example an Observation referenced from HeartlandRiskAssessment.basis holding the point total. The score is a non-validated implementation heuristic: the total is a point count, not a probability, and the tier assigns monitoring intensity rather than predicting an outcome." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 26 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-score-total> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-risk-score-total" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Risk Score Total" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Total of the HEARTLAND risk score: an integer count of 0 to 18 points summed from ten weighted criteria. This is a non-validated implementation heuristic used to assign monitoring intensity; it is a point total, not a probability, not a predicted event rate and not a validated prognostic estimate. It is carried in this extension rather than in RiskAssessment.prediction.probabilityDecimal because that element is defined in FHIR R4 as the likelihood of a specified outcome, expressed as a percentage." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 27 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/CodeSystem/heartland-risk-tier> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/heartland-risk-tier" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Risk Tier" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Qualitative risk stratification tiers from the HEARTLAND Protocol v3.2 risk score (0-18 points). Used in HeartlandRiskAssessment.prediction.qualitativeRisk." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 28 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/ValueSet/heartland-risk-tier-vs> ;
         fhir:Reference.reference [ fhir:value "ValueSet/heartland-risk-tier-vs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Risk Tier Value Set" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "All risk tier codes from the HEARTLAND risk score (low | moderate | high)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 29 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-social-support-score> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-social-support-score" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Social Support Score" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Boolean indicator of limited social support per the HEARTLAND risk score: true = patient lives alone or has limited social support, contributing 1 point. Perceived social isolation has been independently associated with a 3.74-fold increase in mortality among HF patients (HEARTLAND Protocol v3.2, Module 2)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 30 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-synthetic-county-code> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-synthetic-county-code" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Synthetic County Identifier" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Opaque synthetic identifier emitted by HEARTLAND Synthetic, not an ANSI/FIPS county GEOID, postal code, or evidence of real residence. Preserve the code as supplied; no real-geography lookup or linkage is implied." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ] ;
