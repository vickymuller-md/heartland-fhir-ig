     fhir:ImplementationGuide.definition.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CarePlan" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/CarePlan/CarePlanExampleTier2> ;
         fhir:Reference.reference [ fhir:value "CarePlan/CarePlanExampleTier2" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Draft Tier 2 Plan with Track B Context" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Synthetic planning illustration aligned with the Toolkit V3.4 candidate. The historical resource identifier is retained, but no activity is scheduled or completed, no clinician is fabricated and no patient-specific prescription is issued. Tier 2 and Track B are illustrative declared context, not questionnaire-derived decisions or evidence of actual resources." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.heartlandprotocol.org/StructureDefinition/heartland-careplan" ;
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-careplan>
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "RiskAssessment" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/RiskAssessment/RiskAssessmentExampleHigh> ;
         fhir:Reference.reference [ fhir:value "RiskAssessment/RiskAssessmentExampleHigh" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: High-Risk HEARTLAND Risk Assessment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Synthetic risk assessment scoring 11/18 points (>=9 = High Risk tier). Inputs: age >=75 (+2), prior HF hosp 6mo (+3), CKM Stage 3-4 (+2), BP <100 (+2), distance >50 mi (+1), limited social support (+1). Demonstrates a proposed heuristic, not a treatment instruction or validated outcome prediction." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-assessment" ;
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-assessment>
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "QuestionnaireResponse" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/QuestionnaireResponse/QuestionnaireResponseExampleRiskInputs> ;
         fhir:Reference.reference [ fhir:value "QuestionnaireResponse/QuestionnaireResponseExampleRiskInputs" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Risk Input Questionnaire Response (score 11)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Responses to the HeartlandRiskInputQuestionnaire for PatientExampleRural. Six items answered true (age >=75, prior HF hosp 6mo, SBP <100, CKM Stage 3-4, distance >50 mi, limited social support) totaling 11 points -> High Risk tier. Referenced by RiskAssessmentExampleHigh.basis[0]." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-input-response" ;
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-input-response>
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Patient" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/Patient/PatientExampleRural> ;
         fhir:Reference.reference [ fhir:value "Patient/PatientExampleRural" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Rural HF Patient (high-distance, limited support)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "A 78-year-old patient living alone in a rural county without a local cardiologist (87 miles to nearest cardiology care). Demonstrates use of HeartlandDistanceToCardiology and HeartlandSocialSupportScore extensions. Modeled on the cohort described in HEARTLAND Protocol v3.2 background data." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.heartlandprotocol.org/StructureDefinition/heartland-patient" ;
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-patient>
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Observation" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/Observation/ObservationExampleWeightRedFlag> ;
         fhir:Reference.reference [ fhir:value "Observation/ObservationExampleWeightRedFlag" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Example: Synthetic Body Weight Observation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Single synthetic body-mass reading. Historical resource ID retained for compatibility; this example does not establish a weight change, alert, delivery, or clinical response. A rate-of-change threshold is not a numeric reference range for body mass." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.heartlandprotocol.org/StructureDefinition/heartland-remote-monitoring-observation" ;
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-remote-monitoring-observation>
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-careplan> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-careplan" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Care Plan" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Draft planned-activity representation aligned with the HEARTLAND Toolkit V3.4 candidate. Facility tier describes delivery capacity, not clinical eligibility, treatment timing or exclusion of education domains. All eight educational domains are offered at every tier; format, sequence and support can differ. Planned activities are not evidence of professional review, completed teach-back, contact or care. Tier and monitoring-track extensions retain their existing identities. The profile does not encode the full operational journal." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-risk-input-response> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-risk-input-response" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Complete Risk Input Response" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Complete, flat, explicitly answered Boolean input contract for the candidate risk questionnaire. Link IDs identify the ten weighted criteria; response order must also match the Questionnaire. This profile does not resolve unknown clinical inputs, validate the risk heuristic, or prove a referenced RiskAssessment total." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:extension" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/StructureDefinition/heartland-distance-to-cardiology> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/heartland-distance-to-cardiology" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Distance to Cardiology" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Driving distance in miles from the patient's residence to the nearest cardiologist. Used by the HEARTLAND risk score: distance >50 miles contributes 1 point. Rural counties without a cardiologist average 87 miles to nearest cardiology care vs 16 miles in counties with one (HEARTLAND Protocol v3.2, Module 2)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 8 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "CodeSystem" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://fhir.heartlandprotocol.org/CodeSystem/heartland-evidence-level> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/heartland-evidence-level" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "HEARTLAND Evidence Level" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Three-tiered transparency labels distinguishing evidence strength behind HEARTLAND Protocol v3.2 recommendations, helping clinicians calibrate clinical decisions." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 9 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
